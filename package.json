{
  "name": "mcp-ads-manager",
  "version": "2.0.0",
  "description": "Servidor MCP para gestionar Meta Ads y Google Ads desde Claude Desktop",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "start:meta": "node dist/meta_ads/server.js",
    "start:google": "node dist/google_ads/server.js",
    "package:meta": "pkg dist/meta_ads/server.js --target node20-win-x64 --no-bytecode --public --output dist/meta_ads.exe",
    "package:google": "pkg dist/google_ads/server.js --target node20-win-x64 --no-bytecode --public --output dist/google_ads.exe",
    "package:all": "npm run package:meta && npm run package:google"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "dotenv": "^16.4.7",
    "facebook-nodejs-business-sdk": "^24.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@yao-pkg/pkg": "^5.12.1",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
